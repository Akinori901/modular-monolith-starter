# frozen_string_literal: true

source "https://rubygems.org"

gem "rails", "~> 8.1.3", ">= 8.1.3.1"
gem "pg", "~> 1.6"
gem "puma", ">= 6.0"
gem "bootsnap", require: false

# --- パッケージ境界の検証 ---
# 層ではなく「機能パッケージ」の境界を CI で強制する。
# Rails では層に切ると ActiveRecord と戦うことになるため、こちらを採る。
gem "packwerk", "~> 3.3", require: false
# packwerk 3.x では privacy（公開面の強制）が本体から分離され、
# このgemが提供する。入れないと enforce_privacy が
# **無視される**（設定しても何も検知しない。実際に踏んだ）。
gem "packwerk-extensions", "~> 0.3", require: false

# --- 非同期ジョブ ---
# アクセスログ等の「失っても業務が破綻しないログ」を非同期で書く。
gem "sidekiq", "~> 7.3"

# --- AWS ---
gem "aws-sdk-cognitoidentityprovider", "~> 1.150"
gem "aws-sdk-s3", "~> 1.229"
gem "aws-sdk-dynamodb", "~> 1.172"
gem "jwt", "~> 2.10"

# aws-sdk は XML パーサを必須とするが、Ruby 3.4 では rexml が
# 標準添付から外れている。明示しないと起動時に落ちる。
gem "rexml"

group :development, :test do
  gem "debug", platforms: %i[mri windows], require: "debug/prelude"
  gem "rspec-rails", "~> 8.0"
  gem "brakeman", require: false
  gem "rubocop-rails-omakase", require: false
end
